{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "quiz"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "quizes"
    },
    "quiz_questions": {
      "type": "json"
    },
    "passing_mark": {
      "type": "integer",
      "required": true,
      "min": 0,
      "max": 100
    },
    "description": {
      "type": "text"
    }
  }
}
